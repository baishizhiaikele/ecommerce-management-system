# ---- 复制为 .env 并填写（.env 已被 .gitignore 忽略，不会提交）----

# 必填：JWT 签名密钥，生产环境请用强随机值（如 `openssl rand -hex 32`）
SECRET_KEY=change-me-to-a-long-random-string

# 可选：前端实际访问地址（同源部署时填后端地址即可）
FRONTEND_ORIGINS=http://localhost:8000

# 可选：演示种子数据（含弱口令演示账号）；正式生产请改为 false
SEED_DEMO=true

# 可选：AI 能力（留空则自动降级为本地 mock，功能闭环可用）
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# PostgreSQL（docker-compose 使用）
POSTGRES_USER=ai_shop
POSTGRES_PASSWORD=ai_shop
POSTGRES_DB=ai_shop

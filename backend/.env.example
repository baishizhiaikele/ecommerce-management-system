# 复制为 .env 并按需修改
DATABASE_URL=sqlite+aiosqlite:///./ai_shop.db
# 必须替换为足够随机的长密钥（≥32 字符）；缺失该变量应用将无法启动（S1）
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars!
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_ORIGINS=["http://localhost:5173"]
# 是否在启动时灌入演示数据（含弱口令演示账号）；生产环境务必设为 False
SEED_DEMO=False
# 是否允许启动时自动补列（_ensure_demo_columns 兜底）。
# 仅本地/演示/测试环境为 True；生产环境必须保持 False，让 schema 漂移由 Alembic 治理而非静默补列。
ALLOW_SCHEMA_AUTOFIX=False

# 留空则 AI 功能使用本地确定性 mock 降级
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=12

# 支付回调签名密钥（生产必须注入，缺失则应用无法启动）
PAYMENT_SECRET=replace-with-a-long-random-payment-secret-at-least-32-chars!

# 可观测性（T26）：OpenTelemetry 链路追踪（可选，缺依赖/未开启则降级）
OTEL_ENABLED=False
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ecommerce-backend
# 可选 Sentry 错误监控（仅配置 DSN 且安装 sentry-sdk 时启用，否则 no-op）
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ENVIRONMENT=production
